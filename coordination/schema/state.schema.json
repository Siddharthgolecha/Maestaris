{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zerion Worker State",
  "type": "object",
  "required": ["schema", "worker", "project", "lifecycle", "mailbox", "task", "claim", "result", "last_review"],
  "properties": {
    "schema": {"const": 1},
    "worker": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "lifecycle": {
      "enum": ["idle", "assigned", "claimed", "done", "blocked", "needs_review", "dormant"]
    },
    "mailbox": {
      "type": "object",
      "required": ["pr"],
      "properties": {"pr": {"type": ["integer", "null"], "minimum": 1}}
    },
    "task": {
      "type": "object",
      "required": ["id", "status", "priority", "task_pr"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]},
        "priority": {"type": ["string", "null"]},
        "task_pr": {"type": ["integer", "string", "null"]}
      }
    },
    "claim": {
      "type": "object",
      "required": ["dispatcher", "claimed_at", "lease_hours"],
      "properties": {
        "dispatcher": {"type": ["string", "null"]},
        "claimed_at": {"type": ["string", "null"]},
        "lease_hours": {"type": "integer", "minimum": 1}
      }
    },
    "result": {
      "type": "object",
      "required": ["status", "commit", "task_pr"],
      "properties": {
        "status": {"type": ["string", "null"]},
        "commit": {"type": ["string", "null"]},
        "task_pr": {"type": ["integer", "string", "null"]}
      }
    },
    "last_review": {
      "type": "object",
      "required": ["task_id", "status", "reviewed_at"],
      "properties": {
        "task_id": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"]}
      }
    },
    "updated_at": {"type": ["string", "null"]}
  }
}
