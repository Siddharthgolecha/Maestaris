{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zerion Agent",
  "type": "object",
  "required": ["schema", "agent", "project", "role", "dispatcher_pool", "status"],
  "properties": {
    "schema": {"const": 1},
    "agent": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "project": {"type": "string"},
    "role": {"type": "string"},
    "dispatcher_pool": {"type": "string"},
    "status": {"enum": ["active", "blocked", "waiting", "dormant", "completed"]},
    "control_plane": {
      "type": "object",
      "properties": {
        "transport": {"const": "github_issue"}
      },
      "additionalProperties": false
    },
    "project_paths": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
