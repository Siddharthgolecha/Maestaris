{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zerion Registry",
  "type": "object",
  "required": [
    "schema", "protocol_version", "entrypoint", "canonical_branch",
    "orchestrator", "defaults", "github", "pools", "projects"
  ],
  "properties": {
    "schema": {"const": 1},
    "protocol_version": {"const": 4},
    "entrypoint": {"const": "AGENTS.md"},
    "canonical_branch": {"type": "string"},
    "orchestrator": {"type": "string"},
    "defaults": {
      "type": "object",
      "required": ["ack_lease_hours"],
      "properties": {
        "ack_lease_hours": {"type": "integer", "minimum": 1}
      }
    },
    "github": {
      "type": "object",
      "required": [
        "task_transport", "task_title_prefix", "task_label",
        "status_labels", "priority_label_prefix", "task_pull_request",
        "native_reviews", "projects"
      ],
      "properties": {
        "task_transport": {"const": "issue"},
        "task_title_prefix": {"type": "string"},
        "task_label": {"type": "string"},
        "status_labels": {
          "type": "object",
          "required": [
            "ready", "claimed", "blocked", "needs_review",
            "accepted", "revise", "rejected"
          ]
        },
        "priority_label_prefix": {"type": "string"},
        "task_pull_request": {"type": "object"},
        "native_reviews": {"type": "object"},
        "projects": {"type": "object"}
      }
    },
    "pools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["max_tasks_per_run"],
        "properties": {
          "max_tasks_per_run": {"type": "integer", "minimum": 1}
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  }
}
