{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maestaris Project",
  "type": "object",
  "required": [
    "schema", "project", "title", "status", "repository",
    "control_plane", "active_workers", "dormant_workers"
  ],
  "properties": {
    "schema": {"const": 1},
    "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string"},
    "status": {"enum": ["active", "waiting", "dormant", "completed"]},
    "repository": {"type": "string"},
    "runtime": {"type": "string"},
    "canonical_paths": {"type": "array", "items": {"type": "string"}},
    "orchestrator": {"type": ["string", "null"]},
    "auditor": {"type": ["string", "null"]},
    "control_plane": {
      "type": "object",
      "required": ["transport"],
      "properties": {
        "transport": {"const": "github_issue"}
      },
      "additionalProperties": false
    },
    "active_workers": {"type": "array", "items": {"type": "string"}},
    "dormant_workers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
